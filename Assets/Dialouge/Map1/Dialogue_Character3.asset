  lines:
  - speakerName: Ferio
    content: "M\xECnh nghe th\u1EA5y ti\u1EBFng \u0111\u1ED9ng g\xEC \u0111\xF3 \u1EDF
      ph\xEDa b\xEAn kia."
    speakerPortrait: {fileID: 0}
  - speakerName: Ferio
    content: "Ph\u1EA3i di nhanh h\u01A1n m\u1EDBi \u0111\u01B0\u1EE3c!"
    speakerPortrait: {fileID: 0}
  - speakerName: 
    content: "Nh\u1EA5n [Left Shift] \u0111\u1EC3 dash"
    speakerPortrait: {fileID: 0}
  - speakerName: 
    content: "Dash c\xF3 th\u1EC3 g\xE2y s\xE1t th\u01B0\u01A1ng v\xE0 ti\xEAu t\u1ED1n
      1 l\u01B0\u1EE3ng mana nh\u1EA5t \u0111\u1ECBnh! L\u01B0u \xFD nh\xE9!"
    speakerPortrait: {fileID: 0}
